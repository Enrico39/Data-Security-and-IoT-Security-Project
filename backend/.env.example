# Modello delle impostazioni locali del backend.
# Copiare in .env e sostituire ogni "cambiami" con una password casuale.
# Il file .env contiene segreti e non va mai versionato.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=cambiami
MONGO_APP_DB=access_audit
MONGO_APP_USER=ac_backend
MONGO_APP_PASSWORD=cambiami
MQTT_URL=mqtt://127.0.0.1:1884
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASSWORD=cambiami
MQTT_GATEWAY_USER=gw-test-01
MQTT_GATEWAY_PASSWORD=cambiami
